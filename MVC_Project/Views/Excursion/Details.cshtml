@model IvanSusaninProject_Contracts.BindingModels.ExcursionBindingModel
@{
    ViewData["Title"] = "Детали экскурсии";
}

<h2>Детали экскурсии</h2>

<dl class="row">
    <dt class="col-sm-3">Название</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Дата</dt>
    <dd class="col-sm-9">@Model.ExcursionDate</dd>
    <dt class="col-sm-3">Гид</dt>
    <dd class="col-sm-9">@Model.GuideName</dd>
</dl>
<div class="d-flex gap-2 mt-3">
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>
