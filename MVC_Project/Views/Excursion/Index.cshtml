@model List<IvanSusaninProject_Contracts.ViewModels.ExcursionViewModel>

@{
    ViewData["Title"] = "Экскурсии";

}

<h2 class="mb-4">Экскурсии</h2>

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-success">Добавить экскурсию</a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var e in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-id="@e.Id" class="text-decoration-none">@e.Name</a>
                    </h5>
                    <p class="card-text">
                        <strong>Название:</strong> @e.Name
                    </p>
                    <p>
                        <strong>Дата:</strong> @e.ExcursionDate
                    </p>
                    <p>
                        <strong>Гид:</strong> @e.GuideName
                    </p>
                </div>

            </div>
        </div>
    }
</div>