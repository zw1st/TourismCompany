@using IvanSusaninProject_Contracts.Enums
@model IvanSusaninProject_Contracts.BindingModels.GroupBindingModel
@{
    ViewData["Title"] = "Редактировать группу";
}

<h2>Редактировать группу</h2>

<form asp-action="Edit" method="post" class="border p-4 bg-light rounded">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="HumanAmount" class="form-label"></label>
        <input asp-for="HumanAmount" class="form-control" type="number" min="1" />
        <span asp-validation-for="HumanAmount" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="HumanType" class="form-label"></label>
        <select asp-for="HumanType" class="form-control"
                asp-items="Html.GetEnumSelectList<HumanType>()">
            <option value="">-- Выберите тип --</option>
        </select>
        <span asp-validation-for="HumanType" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
