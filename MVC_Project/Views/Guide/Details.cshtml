@model IvanSusaninProject_Contracts.BindingModels.GuideBindingModel
@{
    ViewData["Title"] = "Детали гида";
}

<h2>Детали гида</h2>

<dl class="row">
    <dt class="col-sm-3">ФИО</dt>
    <dd class="col-sm-9">@Model.Fio</dd>

    <dt class="col-sm-3">Стаж</dt>
    <dd class="col-sm-9">@Model.Experience</dd>
    <dt class="col-sm-3">Возраст</dt>
    <dd class="col-sm-9">@Model.Age</dd>
</dl>
<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактировать</a>
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger">Удалить</a>
</div>
