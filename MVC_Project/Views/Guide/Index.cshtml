@model List<IvanSusaninProject_Contracts.ViewModels.GuideViewModel>

@{
    ViewData["Title"] = "Гиды";

}

<h2 class="mb-4">Гиды</h2>

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-success">Добавить гида</a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var e in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-id="@e.Id" class="text-decoration-none">@e.Fio</a>
                    </h5>
                    <p class="card-text">

                        <strong>ФИО:</strong> @e.Fio
                    </p>
                    <p>
                        <strong>Стаж:</strong> @e.Experience
                    </p>
                    <p>
                        <strong>Возраст:</strong> @e.Age
                    </p>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-end">
                    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-primary">Редактировать</a>
                    <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-danger">Удалить</a>
                </div>
            </div>
        </div>
    }
</div>