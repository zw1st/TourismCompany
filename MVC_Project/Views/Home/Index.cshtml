@using System.Security.Claims
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
}

<div class="container">
    <h1>Добро пожаловать, @User.Identity.Name!</h1>

    <!-- Общий контент для всех ролей -->
    <div class="alert alert-info">
        Ваша роль: <strong>@role</strong>
    </div>

    <!-- CRUD-блоки (рендерятся по роли) -->
    <partial name="_RolePartial" model="@role" />
</div>