@{
    ViewBag.Title = "Списки экскурсий по поездкам";
    var trip = ViewBag.Trips as List<IvanSusaninProject_Contracts.ViewModels.TripViewModel>;
}

<h2>Формирование списка экскурсий по поездкам</h2>

@if (trip == null || !trip.Any())
{
    <div class="alert alert-warning">
        У вас нет доступных данных для формирования отчета.
    </div>
}
else
{
    <form id="reportForm" asp-action="TripExcursionsReport" method="post">
        <div class="form-group">
            <label>Выберите поездку:</label>
            @foreach (var trip in trip)
            {
                <div class="form-check">
                    <input type="checkbox" name="SelectedTripIds" value="@trip.Id" class="form-check-input" />
                    <label class="form-check-label">Из @trip.StartCity в @trip.EndCity</label>
                </div>
            }
        </div>

        <div class="form-group mt-3">
            <label>Формат файла:</label>
            <select name="FileFormat" class="form-select">
                <option value=".docx">Word (.docx)</option>
                <option value=".xlsx">Excel (.xlsx)</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Сформировать отчет</button>
    </form>
}

@section Scripts {
    <script>
        document.getElementById('reportForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const formData = new FormData(this);
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Формирование...';

            try {
                const response = await fetch('@Url.Action("TripExcursionsReport")', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || 'Ошибка сервера');
                }

                // Получаем имя файла из headers
                const contentDisposition = response.headers.get('Content-Disposition');
                let fileName = 'отчет.docx';

                if (contentDisposition) {
                    const fileNameMatch = contentDisposition.match(/filename\*?=["']?(?:UTF-8'')?([^;"']+)["']?/);
                    if (fileNameMatch) fileName = fileNameMatch[1];
                }

                // Создаем blob и скачиваем
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);

                const a = document.createElement('a');
                a.href = url;
                a.download = fileName;
                a.style.display = 'none';
                document.body.appendChild(a);
                a.click();

                // Очистка
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);

            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка при формировании отчета: ' + error.message);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Сформировать отчет';
            }
        });
    </script>
}